---
import { getCollection } from "astro:content";
import { Brain, Database, Code, type LucideIcon } from "lucide-react";
import SkillCluster from "./SkillCluster.astro";

const skills = await getCollection("skills");

const categoryIcons: Record<string, LucideIcon> = {
  "Python & ML": Brain,
  "Data & Cloud Platforms": Database,
  "Other Languages": Code,
};
---

<h2 class="font-serif text-3xl font-bold text-slate-900">Skills</h2>
<div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
  {skills.map(({ data }) => (
    <SkillCluster
      category={data.category}
      icon={categoryIcons[data.category] ?? Code}
      items={data.items}
    />
  ))}
</div>
