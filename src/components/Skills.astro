---
import { getCollection } from "astro:content";
import { Brain, Database, Code, type LucideIcon } from "lucide-react";

const skills = await getCollection("skills");

const categoryIcons: Record<string, LucideIcon> = {
  "Python & ML": Brain,
  "Data & Cloud Platforms": Database,
  "Other Languages": Code,
};
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl font-bold text-slate-900">Skills</h2>
  <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {skills.map(({ data }) => {
      const Icon = categoryIcons[data.category] ?? Code;
      return (
        <div class="rounded-lg border border-slate-200 p-6">
          <div class="flex items-center gap-2 text-accent">
            <Icon size={20} />
            <h3 class="font-serif text-lg font-semibold text-slate-900">
              {data.category}
            </h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {data.items.map((item) => (
              <li class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs text-slate-700">
                {item}
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>
