---
import type { LucideIcon } from "lucide-react";

interface Props {
  category: string;
  icon: LucideIcon;
  items: string[];
}

const { category, icon: Icon, items } = Astro.props;
const radius = 38;

function point(angleDeg: number) {
  const rad = ((angleDeg - 90) * Math.PI) / 180;
  return {
    x: 50 + radius * Math.cos(rad),
    y: 50 + radius * Math.sin(rad),
  };
}

const leaves = items.map((label, i) => ({
  label,
  ...point((360 / items.length) * i),
}));
---

<div class="cluster group flex flex-col items-center">
  <div class="relative aspect-square w-full max-w-[300px]">
    <svg
      viewBox="0 0 100 100"
      class="absolute inset-0 h-full w-full text-slate-200"
    >
      {leaves.map((leaf) => (
        <line
          x1="50"
          y1="50"
          x2={leaf.x}
          y2={leaf.y}
          stroke="currentColor"
          stroke-width="0.5"
          class="transition-colors group-hover:text-accent/40"
        />
      ))}
    </svg>

    <div class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-full border border-accent/40 bg-background text-accent shadow-sm">
      <Icon size={22} />
    </div>

    {leaves.map((leaf) => (
      <span
        class="absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-slate-200 bg-background px-3 py-1 font-mono text-xs text-slate-700 shadow-sm transition-colors hover:border-accent hover:text-accent"
        style={`left: ${leaf.x}%; top: ${leaf.y}%;`}
      >
        {leaf.label}
      </span>
    ))}
  </div>

  <p class="mt-2 text-center font-serif text-lg font-semibold text-slate-900">
    {category}
  </p>
</div>
