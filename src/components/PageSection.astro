---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative flex min-h-screen flex-col justify-center px-6 py-24 md:py-32",
    className,
  ]}
>
  <div class="mx-auto w-full max-w-5xl">
    <slot />
  </div>
</section>
