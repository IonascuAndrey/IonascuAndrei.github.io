---
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl font-bold text-slate-900">Projects</h2>
  <div class="mt-8 grid gap-8 md:grid-cols-2">
    {projects.map(({ data }) => (
      <article class="flex flex-col rounded-lg border border-slate-200 p-6">
        <h3 class="font-serif text-xl font-semibold text-slate-900">
          {data.title}
        </h3>
        <p class="mt-2 text-slate-600">{data.summary}</p>

        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-accent">
              Problem
            </dt>
            <dd class="mt-1 text-slate-600">{data.problem}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-accent">
              Approach
            </dt>
            <dd class="mt-1 text-slate-600">{data.approach}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-accent">
              Outcome
            </dt>
            <dd class="mt-1 text-slate-600">{data.outcome}</dd>
          </div>
        </dl>

        {data.metrics && (
          <div class="mt-4 flex flex-wrap gap-4 border-t border-slate-100 pt-4">
            {data.metrics.map((metric) => (
              <div>
                <p class="font-mono text-lg font-semibold text-accent">
                  {metric.value}
                </p>
                <p class="text-xs text-slate-500">{metric.label}</p>
              </div>
            ))}
          </div>
        )}

        <ul class="mt-4 flex flex-wrap gap-2">
          {data.stack.map((tech) => (
            <li class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs text-slate-700">
              {tech}
            </li>
          ))}
        </ul>

        {data.links && (data.links.repo || data.links.demo) && (
          <div class="mt-4 flex gap-4 text-sm font-medium text-accent">
            {data.links.repo && <a href={data.links.repo}>Repo</a>}
            {data.links.demo && <a href={data.links.demo}>Demo</a>}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
