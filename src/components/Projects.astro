---
import { getCollection } from "astro:content";
import { ExternalLink } from "lucide-react";

const allProjects = await getCollection("projects");
const featured = allProjects.filter((p) => p.data.problem);
const other = allProjects.filter((p) => !p.data.problem);
---

<h2 class="font-serif text-3xl font-bold text-slate-900">Projects</h2>
<div class="mt-8 grid gap-8 md:grid-cols-2">
  {featured.map(({ data }) => (
    <article class="flex flex-col rounded-lg border border-slate-200 p-6">
      <h3 class="font-serif text-xl font-semibold text-slate-900">
        {data.title}
      </h3>
      <p class="mt-2 text-slate-600">{data.summary}</p>

      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-accent">
            Problem
          </dt>
          <dd class="mt-1 text-slate-600">{data.problem}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-accent">
            Approach
          </dt>
          <dd class="mt-1 text-slate-600">{data.approach}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-accent">
            Outcome
          </dt>
          <dd class="mt-1 text-slate-600">{data.outcome}</dd>
        </div>
      </dl>

      {data.metrics && (
        <div class="mt-4 flex flex-wrap gap-4 border-t border-slate-100 pt-4">
          {data.metrics.map((metric) => (
            <div>
              <p class="font-mono text-lg font-semibold text-accent">
                {metric.value}
              </p>
              <p class="text-xs text-slate-500">{metric.label}</p>
            </div>
          ))}
        </div>
      )}

      <ul class="mt-4 flex flex-wrap gap-2">
        {data.stack.map((tech) => (
          <li class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs text-slate-700">
            {tech}
          </li>
        ))}
      </ul>

      {data.links &&
        (data.links.repo || data.links.demo || data.links.paper) && (
          <div class="mt-4 flex gap-4 text-sm font-medium text-accent">
            {data.links.repo && <a href={data.links.repo}>Repo</a>}
            {data.links.demo && <a href={data.links.demo}>Demo</a>}
            {data.links.paper && (
              <a
                href={data.links.paper}
                target="_blank"
                rel="noopener noreferrer"
              >
                Paper
              </a>
            )}
          </div>
        )}
    </article>
  ))}
</div>

{other.length > 0 && (
  <div class="mt-16 border-t border-slate-200 pt-10">
    <h3 class="font-serif text-lg font-semibold text-slate-900">Also built</h3>
    <div class="mt-6 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {other.map(({ data }) => (
        <div>
          <div class="flex items-start justify-between gap-3">
            <h4 class="font-serif text-base font-semibold text-slate-900">
              {data.title}
            </h4>
            {data.links?.repo && (
              <a
                href={data.links.repo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${data.title} repository`}
                class="mt-0.5 shrink-0 text-slate-400 transition-colors hover:text-accent"
              >
                <ExternalLink size={15} />
              </a>
            )}
          </div>
          <p class="mt-1.5 text-sm text-slate-600">{data.summary}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {data.stack.map((tech) => (
              <li class="rounded-full bg-slate-100 px-2.5 py-0.5 font-mono text-[11px] text-slate-700">
                {tech}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
)}
