---
import { getCollection } from "astro:content";
import { BadgeCheck } from "lucide-react";

const certifications = await getCollection("certifications");

const groups = Object.values(
  certifications.reduce<
    Record<string, { issuer: string; items: typeof certifications }>
  >((acc, cert) => {
    const key = cert.data.issuer;
    acc[key] ??= { issuer: key, items: [] };
    acc[key].items.push(cert);
    return acc;
  }, {}),
).sort((a, b) => b.items.length - a.items.length);
---

<h2 class="font-serif text-3xl font-bold text-slate-900">Certifications</h2>

<div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
  <p class="font-mono text-5xl font-semibold text-accent">
    {certifications.length}
  </p>
  <p class="max-w-xs text-sm text-slate-600">
    credentials, earned in a five-month stretch across 2025.
  </p>
</div>

<div class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
  {groups.map((group) => (
    <div class="border-t border-slate-200 pt-4">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-serif text-lg font-semibold text-slate-900">
          {group.issuer}
        </h3>
        <span class="whitespace-nowrap font-mono text-xs text-slate-400">
          {group.items.length}{" "}
          {group.items.length === 1 ? "credential" : "credentials"}
        </span>
      </div>
      <ul class="mt-3 space-y-2.5">
        {group.items.map(({ data }) => (
          <li class="flex items-start gap-2.5">
            <BadgeCheck size={16} className="mt-0.5 shrink-0 text-accent" />
            <span class="text-sm text-slate-700">{data.name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
