---
import {
  Plane,
  Users,
  Globe,
  GraduationCap,
  Handshake,
  Rocket,
  Sparkles,
  Landmark,
  type LucideIcon,
} from "lucide-react";

interface LeadershipItem {
  title: string;
  date: string;
  status?: "present" | "upcoming";
  description: string;
  icon: LucideIcon;
}

const items: LeadershipItem[] = [
  {
    title: "Erasmus+",
    date: "2022",
    description:
      "Took part in this EU-funded international student exchange program.",
    icon: Plane,
  },
  {
    title: "Leaders Foundation",
    date: "May 2025 - Present",
    status: "present",
    description:
      "Community manager at this NGO, which runs certified educational programmes for people of all ages with its own trainers and curricula. Its peer network is a byproduct of that work.",
    icon: Users,
  },
  {
    title: "EuroTech x HKTE Hackathon",
    date: "June 2025",
    description:
      "Volunteered at this hackathon connecting European and Hong Kong tech talent.",
    icon: Globe,
  },
  {
    title: "Leadership Summer School",
    date: "2026",
    description:
      "Took part in this program run by the Mummert Alumni Association, and stayed on as a member of its alumni community.",
    icon: GraduationCap,
  },
  {
    title: "EuroTech Federation",
    date: "Sep 2026 - Present",
    status: "present",
    description: "Core team member on community and fellowship.",
    icon: Handshake,
  },
  {
    title: "Susterum Accelerator",
    date: "Oct 2026 - Jun 2027",
    status: "upcoming",
    description:
      "Will be a member of the first cohort of this EU community-building accelerator, a nine-month program.",
    icon: Rocket,
  },
  {
    title: "Apply AI Summit",
    date: "Nov 17, 2026",
    status: "upcoming",
    description:
      "Will attend this European Commission summit on AI adoption, in Brussels.",
    icon: Sparkles,
  },
  {
    title: "DPIN",
    date: "Starting 2027",
    status: "upcoming",
    description:
      "Will join the DPIN core team starting in 2027, after taking part in the DPIN Brussels AI Governance Hackathon.",
    icon: Landmark,
  },
];
---

<h2 class="font-serif text-3xl font-bold text-slate-900">
  Leadership &amp; International Engagement
</h2>

<div id="leadership-timeline" class="relative mx-auto mt-12 max-w-3xl">
  <div class="absolute left-4 top-0 h-full w-px border-l border-dashed border-slate-300 md:left-1/2 md:-translate-x-1/2"></div>

  <div class="space-y-10 md:space-y-14">
    {items.map((item, i) => {
      const onRight = i % 2 === 1;
      const badgeClass =
        item.status === "present"
          ? "bg-accent/10 text-accent"
          : "bg-slate-100 text-slate-500";
      const dateRow = (justify: string) => (
        <p
          class={`flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wide text-slate-500 ${justify}`}
        >
          <span>{item.date}</span>
          {item.status && (
            <span
              class={`rounded-full px-2 py-0.5 text-[10px] font-semibold normal-case tracking-normal ${badgeClass}`}
            >
              {item.status === "present" ? "Present" : "Upcoming"}
            </span>
          )}
        </p>
      );
      return (
        <div class="leadership-item relative pl-12 opacity-0 transition-all duration-700 ease-out md:grid md:grid-cols-2 md:gap-x-10 md:pl-0">
          <span
            data-side={onRight ? "right" : "left"}
            class="leadership-dot absolute left-4 top-0 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full border-2 border-slate-300 bg-background text-slate-400 transition-colors duration-500 md:left-1/2"
          >
            <item.icon size={15} />
          </span>

          {onRight ? (
            <>
              <div class="hidden md:block" />
              <div class="md:pl-9">
                {dateRow("md:justify-start")}
                <p class="mt-1 font-serif text-base font-semibold text-slate-900">
                  {item.title}
                </p>
                <p class="mt-1 text-sm text-slate-600">{item.description}</p>
              </div>
            </>
          ) : (
            <>
              <div class="md:pr-9 md:text-right">
                {dateRow("md:justify-end")}
                <p class="mt-1 font-serif text-base font-semibold text-slate-900">
                  {item.title}
                </p>
                <p class="mt-1 text-sm text-slate-600">{item.description}</p>
              </div>
              <div class="hidden md:block" />
            </>
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  .leadership-item:has(.leadership-dot[data-side="left"]) {
    transform: translateY(0.75rem) translateX(-0.75rem);
  }
  .leadership-item:has(.leadership-dot[data-side="right"]) {
    transform: translateY(0.75rem) translateX(0.75rem);
  }

  .leadership-item.revealed {
    opacity: 1;
    transform: translate(0, 0);
  }
  .leadership-item.revealed .leadership-dot {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .leadership-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>(".leadership-item");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    items.forEach((item) => item.classList.add("revealed"));
  } else if (items.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
    );
    items.forEach((item) => observer.observe(item));
  }
</script>
