---
import { Mail, ExternalLink, Check } from "lucide-react";

const contact = {
  email: "ionascuandrei320@gmail.com",
  linkedin: "https://linkedin.com/in/andrei-ionascu",
  github: "https://github.com/IonascuAndrey",
};

const ctaBase =
  "magnetic relative inline-flex items-center gap-2 overflow-visible rounded-md px-5 py-2.5 text-sm font-medium transition-colors";
const ctaPrimary = `${ctaBase} bg-accent text-white hover:bg-slate-900`;
const ctaSecondary = `${ctaBase} border border-slate-300 text-slate-700 hover:border-accent hover:text-accent`;
---

<h2 class="font-serif text-3xl font-bold text-slate-900">Contact</h2>
<p class="mt-4 max-w-xl text-slate-600">
  <slot>
    Open to data engineering and ML roles, collaborations, and conversations.
  </slot>
</p>

<div class="mt-6 flex flex-wrap gap-4">
  <a
    href={`mailto:${contact.email}`}
    id="email-cta"
    data-email={contact.email}
    class={ctaPrimary}
  >
    <span class="relative flex h-4 w-4 items-center justify-center">
      <Check
        size={16}
        className="icon-check absolute inset-0 scale-50 opacity-0 transition-all duration-300"
      />
      <Mail size={16} className="icon-mail transition-all duration-300" />
    </span>
    <span id="email-label">{contact.email}</span>
  </a>
  <a
    href={contact.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class={ctaSecondary}
  >
    <ExternalLink size={16} />
    LinkedIn
  </a>
  <a
    href={contact.github}
    target="_blank"
    rel="noopener noreferrer"
    class={ctaSecondary}
  >
    <ExternalLink size={16} />
    GitHub
  </a>
</div>

<style>
  .magnetic {
    will-change: transform;
  }

  #email-cta.copied .icon-mail {
    opacity: 0;
    transform: scale(0.5) rotate(-15deg);
  }
  #email-cta.copied .icon-check {
    opacity: 1;
    transform: scale(1);
  }

  .confetti-dot {
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-accent);
    border: 1.5px solid white;
    pointer-events: none;
    animation: confetti-pop 650ms cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  @keyframes confetti-pop {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy)))
        scale(0);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .magnetic {
      transform: none !important;
      transition: none !important;
    }
    .confetti-dot {
      display: none;
    }
  }
</style>

<script>
  const emailBtn = document.getElementById("email-cta");
  const emailLabel = document.getElementById("email-label");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (emailBtn && emailLabel) {
    const originalLabel = emailLabel.textContent ?? "";
    let resetTimer: number | undefined;

    emailBtn.addEventListener("click", () => {
      const email = emailBtn.dataset.email;
      if (email && navigator.clipboard) {
        navigator.clipboard.writeText(email).catch(() => {});
      }

      emailBtn.classList.add("copied");
      emailLabel.textContent = "Copied to clipboard!";

      if (!reduceMotion) {
        for (let i = 0; i < 8; i++) {
          const dot = document.createElement("span");
          dot.className = "confetti-dot";
          const angle = Math.random() * Math.PI * 2;
          const distance = 26 + Math.random() * 18;
          dot.style.setProperty("--dx", `${Math.cos(angle) * distance}px`);
          dot.style.setProperty("--dy", `${Math.sin(angle) * distance}px`);
          dot.style.left = `${10 + Math.random() * 20}%`;
          emailBtn.appendChild(dot);
          dot.addEventListener("animationend", () => dot.remove());
        }
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        emailBtn.classList.remove("copied");
        emailLabel.textContent = originalLabel;
      }, 1800);
    });
  }

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>(".magnetic").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        el.style.transition = "transform 80ms ease-out";
      });
      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        el.style.transform = `translate(${x * 0.2}px, ${y * 0.3}px)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transition =
          "transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1)";
        el.style.transform = "translate(0, 0)";
      });
    });
  }
</script>
